<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="22dp"
    android:paddingEnd="48dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="@color/text"
        android:textSize="32sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowProfile"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="我的资料" />

                <TextView
                    android:id="@+id/tvProfile"
                    style="@style/SettingValue"
                    android:text="🐷 小朋友" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="改 ›" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowStage"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="学习阶段" />

                <TextView
                    android:id="@+id/tvStage"
                    style="@style/SettingValue"
                    android:text="50 以内加减" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="◀ ▶" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowCount"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="每轮题数" />

                <TextView
                    android:id="@+id/tvCount"
                    style="@style/SettingValue"
                    android:text="10 题" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="◀ ▶" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMode"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="练习方式" />

                <TextView
                    android:id="@+id/tvMode"
                    style="@style/SettingValue"
                    android:text="练习（不限时）" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="◀ ▶" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowStyle"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="题型（含找错题）" />

                <TextView
                    android:id="@+id/tvStyle"
                    style="@style/SettingValue"
                    android:text="计算 + 找错" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="◀ ▶" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSpeed"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="读题语速" />

                <TextView
                    android:id="@+id/tvSpeed"
                    style="@style/SettingValue"
                    android:text="正常" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="◀ ▶" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSound"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="答题音效" />

                <TextView
                    android:id="@+id/tvSound"
                    style="@style/SettingValue"
                    android:text="开" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="切换" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSpeak"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="语音读题" />

                <TextView
                    android:id="@+id/tvSpeak"
                    style="@style/SettingValue"
                    android:text="开" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="切换" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowUnlock"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="解锁全部阶段" />

                <TextView
                    android:id="@+id/tvUnlock"
                    style="@style/SettingValue"
                    android:text="关" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="切换" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowClear"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="清空练习记录" />

                <TextView
                    android:id="@+id/tvClear"
                    style="@style/SettingValue"
                    android:text="OK 键确认" />

                <TextView
                    style="@style/SettingArrow"
                    android:text="⚠" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="方向键选择 · OK 确认或切换 · 返回键回首页"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />
</LinearLayout>
