<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="手机扫码填写"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="手机和电视连同一个 WiFi，扫码后在手机上填名字、选头像"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/qrImage"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvQrUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="http://192.168.1.8:8080"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvQrStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="等待手机提交…"
        android:textColor="@color/accent"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnCloseQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_key"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="关闭"
        android:textColor="@color/text"
        android:textSize="15sp" />
</LinearLayout>
