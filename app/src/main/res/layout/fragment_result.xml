<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="20dp"
    android:paddingEnd="48dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="练习完成！"
        android:textColor="@color/text"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/tvStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.12"
        android:text="★  ★  ★"
        android:textColor="@color/accent"
        android:textSize="44sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="100"
                android:textColor="@color/accent"
                android:textSize="68sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLine1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一次答对 10 / 10 题"
                android:textColor="@color/text"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvLine2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="正确率 100% · 用时 1 分 12 秒 · 平均 7.2 秒/题"
                android:textColor="@color/text_dim"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvLine3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="算力 612（数学高手）"
                android:textColor="@color/blue"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unlockBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🎉 解锁新难度"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvUnlockName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="100 以内加减"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUnlockTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="S4 · 两位数综合"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGoNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/selector_key"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="现在去练"
                android:textColor="@color/key_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="0.6"
                android:background="@drawable/selector_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="待会儿"
                android:textColor="@color/text"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWrongTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="错题回顾"
        android:textColor="@color/red"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 错题列表吃掉剩余空间：以前固定 100dp，内容一多就把「再来一轮」挤出屏幕 -->
    <ScrollView
        android:id="@+id/wrongScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:minHeight="60dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/wrongList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- clipChildren=false：焦点放大会把按钮描边撑出父容器，默认裁剪会把边框吃掉一半 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingTop="11dp"
            android:paddingEnd="36dp"
            android:paddingBottom="11dp"
            android:text="再来一轮"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:background="@drawable/selector_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="36dp"
            android:paddingTop="11dp"
            android:paddingEnd="36dp"
            android:paddingBottom="11dp"
            android:text="回首页"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 刚播报的那句话，家长也能对照着看 -->
    <TextView
        android:id="@+id/tvSpeakHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
